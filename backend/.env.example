PORT=3000
NODE_ENV=development

FRONTEND_BASE_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:3000

DATABASE_URL=mongodb://127.0.0.1:27017/playlisthub

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback
SPOTIFY_STATE_SECRET=replace_with_a_long_random_secret
SPOTIFY_TOKEN_ENCRYPTION_SECRET=replace_with_a_long_random_secret

ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
